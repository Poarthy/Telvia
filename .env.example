# Copy to .env and fill in (get the values from https://my.telegram.org → API development tools)
TG_API_ID=
TG_API_HASH=

# Optional: proxy used only by tools/login.py (direct connection to Telegram)
# TG_PROXY=socks5://127.0.0.1:1080

# Optional: override the local data directory (default ~/.tg-bridge)
# TG_BRIDGE_HOME=
